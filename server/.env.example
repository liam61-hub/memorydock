# === Server ===
HOST=127.0.0.1
PORT=40889

# === Storage (all optional; defaults shown) ===
# One stable per-user data root, independent of the working directory.
# Default: ~/.memorydock  (C:\Users\<user>\.memorydock on Windows).
# MEMORYDOCK_HOME=
# LanceDB index directory. Default: <home>/index
# MEMORYDOCK_INDEX_PATH=
# Canonical Markdown notes directory. Default: <home>/notes
# MEMORYDOCK_NOTES_PATH=
# Settings file (embedding provider, LLM). Default: <home>/config.json
# MEMORYDOCK_CONFIG_PATH=

# === Embedding (OpenAI-compatible API, bring your own key) ===
# Works with OpenAI, together.ai, Ollama (http://localhost:11434/v1) and any
# OpenAI-compatible endpoint. Configure with "memorydock init" instead when
# possible — it validates the provider before saving.
EMBEDDING_API_KEY=sk-your-api-key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_MAX_RETRIES=3

# === LLM summary for project imports (OpenAI-compatible, optional) ===
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
